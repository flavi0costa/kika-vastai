FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime

WORKDIR /workspace

RUN apt update && apt install -y git wget python3-pip

# ComfyUI
RUN git clone https://github.com/comfyanonymous/ComfyUI

WORKDIR /workspace/ComfyUI
RUN pip install -r requirements.txt

# WAN Wrapper
WORKDIR /workspace/ComfyUI/custom_nodes
RUN git clone https://github.com/kijai/ComfyUI-WanVideoWrapper

WORKDIR /workspace/ComfyUI
RUN pip install -r custom_nodes/ComfyUI-WanVideoWrapper/requirements.txt

# Pastas
RUN mkdir -p models/diffusion_models models/text_encoders models/vae

# Script auto download
COPY download_models.sh /workspace/download_models.sh
RUN chmod +x /workspace/download_models.sh

# Porta
EXPOSE 8188

CMD ["/bin/bash", "-c", "/workspace/download_models.sh && python main.py --listen 0.0.0.0 --port 8188"]